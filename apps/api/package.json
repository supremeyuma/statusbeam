    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.9",
    "@swc/core": "^1.10.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "unplugin-swc": "^1.5.1",
    "vitest": "^3.2.7"
  }
